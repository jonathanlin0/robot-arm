<mujoco model="SO-101 stacking inside four walls">
  <include file="../models/so101/so101.xml"/>

  <!-- Resolve mesh paths from this project-owned scene directory. -->
  <compiler meshdir="../models/so101/assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20" offwidth="1024" offheight="1024"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <!-- Construction-paper defaults; geom RGBA below supplies each base color. -->
    <material name="construction_paper" rgba="1 1 1 1" specular="0.2" shininess="0.1" reflectance="0"/>
  </asset>

  <worldbody>
    <!-- Invisible target at the center of the enclosed tabletop. -->
    <body name="workspace_center" pos="0.20 0 0"/>
    <light name="overhead" pos="0 0 1.524" mode="targetbody" target="workspace_center"
      directional="false" castshadow="true"/>

    <!-- The included arm's base stays at (0, 0, 0). Tabletop is z=0.
         Construction-paper bases are shared by data generation and validation.
         Brown #926849; RGB components are the corresponding bytes / 255. -->
    <geom name="table" type="box" pos="0.25 0 -0.025" size="0.45 0.35 0.025"
      friction="0.8 0.005 0.0001" material="construction_paper"
      rgba="0.5725490196 0.4078431373 0.2862745098 1"/>

    <!-- Inside bounds: x=[-0.05, 0.45], y=[-0.25, 0.25] metres.
         Walls are 2 mm thick and 50 cm tall, extending outward from the bounds.
         MuJoCo box sizes are half-extents. X walls also cover the corners.
         Top-down convention: +X right, +Y up. Left/right (X) are red #B64545;
         top/bottom (Y) are green #4E8A54. Validation uses these exact bases. -->
    <geom name="wall_x_min" type="box" pos="-0.051 0 0.25" size="0.001 0.252 0.25"
      friction="0.8 0.005 0.0001" material="construction_paper"
      rgba="0.7137254902 0.2705882353 0.2705882353 1"/>
    <geom name="wall_x_max" type="box" pos="0.451 0 0.25" size="0.001 0.252 0.25"
      friction="0.8 0.005 0.0001" material="construction_paper"
      rgba="0.7137254902 0.2705882353 0.2705882353 1"/>
    <geom name="wall_y_min" type="box" pos="0.20 -0.251 0.25" size="0.25 0.001 0.25"
      friction="0.8 0.005 0.0001" material="construction_paper"
      rgba="0.3058823529 0.5411764706 0.3294117647 1"/>
    <geom name="wall_y_max" type="box" pos="0.20 0.251 0.25" size="0.25 0.001 0.25"
      friction="0.8 0.005 0.0001" material="construction_paper"
      rgba="0.3058823529 0.5411764706 0.3294117647 1"/>

    <!-- Same 4 cm, 40 g cubes and initial placements as the previous scene. -->
    <body name="orange_cube" pos="0.30 -0.08 0.02">
      <freejoint name="orange_cube_joint"/>
      <geom name="orange_cube_geom" type="box" size="0.02 0.02 0.02" mass="0.04"
        friction="0.8 0.005 0.0001" rgba="1.0 0.3 0.0 1"/>
    </body>

    <body name="blue_cube" pos="0.30 0.08 0.02">
      <freejoint name="blue_cube_joint"/>
      <geom name="blue_cube_geom" type="box" size="0.02 0.02 0.02" mass="0.04"
        friction="0.8 0.005 0.0001" rgba="0.05 0.25 1.0 1"/>
    </body>

    <!-- External perspective camera inset 2 cm from the upper-right corner, 20 cm above the surface.
         Preserve the original viewing angle; its ray meets the tabletop at (0.18, -0.02, 0).
         MuJoCo cameras look along local -Z.
         Local X = normalize((-1, 1, 0)); local Y = normalize((-2, -2, 5)),
         giving local -Z = normalize((-5, -5, -4)). -->
    <camera name="external" mode="fixed" pos="0.43 0.23 0.20"
      xyaxes="-0.707106781186548 0.707106781186548 0 -0.348155311911396 -0.348155311911396 0.870388279778489"
      projection="perspective" fovy="90"/>
  </worldbody>
</mujoco>
